{#
/**
 * @file
 * Parc Component - front page hero video.
 *
 * Replaces the hero slideshow with the PARC trailer. The landscape and the
 * portrait cut are picked client side, so only one of the two files is ever
 * downloaded.
 *
 * Available variables:
 * - hero_video.landscape: URL of the landscape cut.
 * - hero_video.portrait: URL of the portrait cut.
 * - hero_video.poster: URL of the poster image (optional).
 *
 * @see parc_preprocess_block__block_content__carousel()
 */
#}

{{ attach_library('parc/b--hero-video') }}

<div class="hero-video">
  <div class="hero-video__inner">
    {# The src is set by script.js so that only the cut matching the current
       viewport is fetched. #}
    <video
      class="hero-video__player"
      data-hero-video
      data-src-landscape="{{ hero_video.landscape }}"
      data-src-portrait="{{ hero_video.portrait }}"
      {% if hero_video.poster %}poster="{{ hero_video.poster }}"{% endif %}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      disablepictureinpicture
      aria-label="{{ 'PARC trailer'|t }}"></video>

    <noscript>
      <video class="hero-video__player" controls muted loop playsinline preload="metadata">
        <source src="{{ hero_video.landscape }}" type="video/mp4">
      </video>
    </noscript>

    <button type="button" class="hero-video__sound" data-hero-video-sound aria-pressed="false">
      <span class="hero-video__sound-label visually-hidden" data-hero-video-sound-label>{{ 'Turn sound on'|t }}</span>

      <svg class="hero-video__sound-icon hero-video__sound-icon--off" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M11 5 6 9H2v6h4l5 4V5Z" fill="currentColor"/>
        <path d="m16 9 5 6m0-6-5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>

      <svg class="hero-video__sound-icon hero-video__sound-icon--on" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M11 5 6 9H2v6h4l5 4V5Z" fill="currentColor"/>
        <path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</div>
