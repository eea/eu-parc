{#
/**
 * @file
 * Parc override to display a node.
 */
#}

{{ attach_library('parc/n--article-compact') }}

{% set color = node.field_tags.entity.field_color.value.0.color %}
{% set bg_color = node.field_tags.entity.field_bg_color.color %}

{%
  set classes = [
    'node',
    'node--' ~ node.bundle|clean_class,
    view_mode ? 'node--' ~ node.bundle|clean_class ~ '--' ~ view_mode|clean_class,
    bg_color ? 'node--article--has-bg-color',
  ]
%}

<article{{attributes.addClass(classes).setAttribute('style','--nn-c-cat:'~color~';'~(bg_color ? '--nn-c-bg:'~bg_color~';' : ''))}}>
  {{ title_prefix }}
  {{ title_suffix }}

  <div class="container-head">
    <div class="head-menu">
      {{ drupal_block('menu_block:main', {
        label_display: false,
        follow: false,
        follow_parent: 'child',
        label_link: false,
        label_type: 'block',
        level: 3,
        depth: 0,
        expand_all_items: false,
        parent: 'main:',
        suggestion: 'sidebar_dropdown',
      }, false) }}
    </div>

    <div class="head-title">
      {{- content.field_tags -}}

      <h1 class="node-title fw-bold">
        {{- label -}}
      </h1>
    </div>

    <div class="field-date">
      {{- date -}}
    </div>
  </div>

  {{ content.field_image }}

  {{ content.field_paragraphs }}
  {{ content|without('field_paragraphs', 'field_image', 'field_tags')}}
</article>
