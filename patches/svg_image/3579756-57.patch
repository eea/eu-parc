+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\svg_image\Kernel;
+
+use Drupal\Core\Database\Database;
+use Drupal\file\Entity\File;
+use Drupal\image\Entity\ImageStyle;
+use Drupal\KernelTests\KernelTestBase;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Tests SVG handling in the image_style theme hook.
+ */
+#[Group('svg_image')]
+class SvgImageStyleThemeTest extends KernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'dblog',
+    'file',
+    'image',
+    'svg_image',
+    'system',
+    'user',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    $this->installEntitySchema('file');
+    $this->installEntitySchema('user');
+    $this->installSchema('dblog', ['watchdog']);
+    $this->installSchema('file', ['file_usage']);
+  }
+
+  /**
+   * Tests replacing core image_style preprocess callbacks across core versions.
+   */
+  public function testThemeRegistryAlterReplacesCorePreprocessCallbacks(): void {
+    $registry = [
+      'image_style' => [
+        'initial preprocess' => 'Drupal\\image\\Hook\\ImageThemeHooks:preprocessImageStyle',
+        'preprocess functions' => ['custom_preprocess'],
+      ],
+    ];
+    svg_image_theme_registry_alter($registry);
+    $this->assertSame('svg_image_preprocess_image_style', $registry['image_style']['initial preprocess']);
+    $this->assertSame(['custom_preprocess'], $registry['image_style']['preprocess functions']);
+
+    $registry = [
+      'image_style' => [
+        'preprocess functions' => [
+          'template_preprocess_image_style',
+          ['Drupal\\image\\Hook\\ImageThemeHooks', 'preprocessImageStyle'],
+          'custom_preprocess',
+        ],
+      ],
+    ];
+    svg_image_theme_registry_alter($registry);
+    $this->assertSame(['custom_preprocess', 'svg_image_preprocess_image_style'], $registry['image_style']['preprocess functions']);
+  }
+
+  /**
+   * Tests that SVG image_style preprocessing does not log a warning for SVGs.
+   */
+  public function testSvgImageStyleDoesNotLogUnsupportedStyleWarning(): void {
+    $svg = File::create([
+      'uri' => 'public://test-image.svg',
+      'filename' => 'test-image.svg',
+      'filemime' => 'image/svg+xml',
+    ]);
+    file_put_contents($svg->getFileUri(), <<<'SVG'
+<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"></svg>
+SVG);
+    $svg->save();
+
+    ImageStyle::create([
+      'name' => 'image_test',
+      'label' => 'Image test',
+    ])->save();
+
+    Database::getConnection()->truncate('watchdog')->execute();
+
+    $variables = [
+      'style_name' => 'image_test',
+      'uri' => $svg->getFileUri(),
+      'width' => 32,
+      'height' => 32,
+      'attributes' => [],
+    ];
+    svg_image_preprocess_image_style($variables);
+
+    $this->assertSame('image', $variables['image']['#theme']);
+    $this->assertSame($svg->getFileUri(), $variables['image']['#uri']);
+    $this->assertTrue($variables['image']['#access']);
+    $this->assertContains('no-image-style', $variables['image']['#attributes']['class']);
+
+    $warning_count = Database::getConnection()->select('watchdog', 'w')
+      ->condition('type', 'image')
+      ->condition('message', 'Could not apply @style image style to @uri because the style does not support it.')
+      ->countQuery()
+      ->execute()
+      ->fetchField();
+    $this->assertSame(0, (int) $warning_count);
+  }
+
+}
