     }
   }
+
+  if (\array_key_exists('alt', $variables)) {
+    $variables['image']['#alt'] = $variables['alt'];
+  }
+  if (\array_key_exists('title', $variables)) {
+    $variables['image']['#title'] = $variables['title'];
+  }
