 use Drupal\file\Entity\File;
+use Drupal\image\Entity\ImageStyle;
 use Drupal\svg_image\Plugin\Field\FieldFormatter\SvgImageFormatter;
 use Drupal\svg_image\Plugin\Field\FieldFormatter\SvgImageUrlFormatter;
 use Drupal\svg_image\Plugin\Field\FieldWidget\SvgImageWidget;
 
+/**
+ * Implements hook_theme_registry_alter().
+ */
+function svg_image_theme_registry_alter(&$theme_registry) {
+  if (empty($theme_registry['image_style'])) {
+    return;
+  }
+
+  $core_preprocess_callbacks = [
+    'template_preprocess_image_style',
+    'Drupal\\image\\Hook\\ImageThemeHooks:preprocessImageStyle',
+    'Drupal\\image\\Hook\\ImageThemeHooks::preprocessImageStyle',
+  ];
+
+  if (!empty($theme_registry['image_style']['initial preprocess']) && in_array($theme_registry['image_style']['initial preprocess'], $core_preprocess_callbacks, TRUE)) {
+    $theme_registry['image_style']['initial preprocess'] = 'svg_image_preprocess_image_style';
+  }
+
+  $preprocess = $theme_registry['image_style']['preprocess functions'] ?? [];
+  $preprocess = array_values(array_filter($preprocess, function ($callback) use ($core_preprocess_callbacks) {
+    if (is_string($callback)) {
+      return !in_array($callback, array_merge($core_preprocess_callbacks, ['svg_image_preprocess_image_style']), TRUE);
+    }
+    if (is_array($callback)) {
+      return !($callback[0] === 'Drupal\\image\\Hook\\ImageThemeHooks' && $callback[1] === 'preprocessImageStyle');
+    }
+    return TRUE;
+  }));
+
+  if (($theme_registry['image_style']['initial preprocess'] ?? NULL) !== 'svg_image_preprocess_image_style') {
+    $preprocess[] = 'svg_image_preprocess_image_style';
+  }
+
+  $theme_registry['image_style']['preprocess functions'] = $preprocess;
+}
