From: Karl Shea <karl@karlshea.dev>
Date: Mon, 2 Mar 2026 18:07:04 -0600
Subject: [PATCH 1/2] Fix saving under parent item

---
 src/Entity/TaxonomyMenu.php | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/Entity/TaxonomyMenu.php b/src/Entity/TaxonomyMenu.php
index 3335365..0ccb7ba 100644
--- a/src/Entity/TaxonomyMenu.php
+++ b/src/Entity/TaxonomyMenu.php
@@ -270,7 +270,7 @@ class TaxonomyMenu extends ConfigEntityBase implements TaxonomyMenuInterface {
 
     // Note:
     // if menu_parent_id is NULL, it will not update the hierarchy properly.
-    if (empty($menu_parent_id) && !$this->getMenuParent()) {
+    if (empty($menu_parent_id) && $this->getMenuParent()) {
       $menu_parent_id = str_replace($this->getMenu() . ':', '', $this->getMenuParent());
     }
 
